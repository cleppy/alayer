{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "layer",
  "version": "0.1.0",
  "identifier": "app.layer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "layer",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../../sidecars/bin/yt-dlp.exe": "sidecars/bin/yt-dlp.exe",
      "../../../sidecars/bin/ffmpeg.exe": "sidecars/bin/ffmpeg.exe",
      "../../../sidecars/bin/ffprobe.exe": "sidecars/bin/ffprobe.exe",
      "../../../sidecars/bin/aria2c.exe": "sidecars/bin/aria2c.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
